# ========================================
# Tanamanku — Environment Configuration
# ========================================
# Copy file ini ke .env dan konfigurasi sesuai environment.
# Untuk production, pastikan APP_ENV=production dan APP_DEBUG=false

# ----- Application -----
APP_NAME="Tanamanku"
APP_ENV=local               # production | local
APP_KEY=                     # Generate: php artisan key:generate
APP_DEBUG=true              # false untuk production
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000  # https://tanamanku.id untuk production

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# ----- Security -----
BCRYPT_ROUNDS=12            # 12 standar industri, naikkan ke 14 untuk high-security

# ----- Logging -----
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug             # warning untuk production

# ----- Database -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tanamanku
DB_USERNAME=root
DB_PASSWORD=

# ----- Session (Security Critical) -----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # WAJIB true untuk production
SESSION_PATH=/
SESSION_DOMAIN=null          # .tanamanku.id untuk production
SESSION_SECURE=false        # WAJIB true untuk production (HTTPS)
SESSION_HTTPONLY=true       # WAJIB true untuk production
SESSION_SAME_SITE=lax       # lax atau strict untuk production

# ----- Cache & Queue -----
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=tanamanku_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Mail -----
MAIL_MAILER=log             # smtp untuk production
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tanamanku.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Tanamanku Custom =====

# ----- CORS (Security) -----
FRONTEND_URL=http://localhost:5173  # https://tanamanku.id untuk production

# ----- Sanctum Auth -----
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173  # tanamanku.id untuk production
SANCTUM_TOKEN_EXPIRATION=10080  # 7 hari dalam menit

# ----- Payment Gateway -----
PAYMENT_PROVIDER=stub       # midtrans | xendit | tripay | stub
PAYMENT_WEBHOOK_SECRET=     # WAJIB diisi untuk production
PAYMENT_WEBHOOK_HEADER=X-Webhook-Signature
