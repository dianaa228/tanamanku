{
  "openapi": "3.0.3",
  "info": {
    "title": "Tanamanku API",
    "description": "Urban Gardening Marketplace & Management Platform REST API. Backend Laravel 11 + Sanctum auth. Base URL: /api/v1",
    "version": "1.0.0",
    "contact": {
      "name": "Tanamanku Team",
      "email": "api@tanamanku.id"
    }
  },
  "servers": [
    { "url": "http://localhost:8000/api/v1", "description": "Local development" },
    { "url": "https://api.tanamanku.id/api/v1", "description": "Production" }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentication & registration" },
    { "name": "Categories", "description": "Product categories" },
    { "name": "Products", "description": "Product marketplace" },
    { "name": "Stores", "description": "Seller stores" },
    { "name": "Cart", "description": "Shopping cart" },
    { "name": "Orders", "description": "Customer orders" },
    { "name": "Payments", "description": "Payment processing" },
    { "name": "Reviews", "description": "Product reviews" },
    { "name": "My Garden", "description": "User plant garden" },
    { "name": "Plant Species", "description": "Plant species database" },
    { "name": "Plant Finder", "description": "Plant recommendation engine" },
    { "name": "Plant Diagnosis", "description": "Plant health diagnosis" },
    { "name": "Community", "description": "Community posts & comments" },
    { "name": "Plant Exchange", "description": "Plant listing & exchange" },
    { "name": "Services", "description": "Gardening services" },
    { "name": "Notifications", "description": "User notifications" },
    { "name": "Loyalty", "description": "Loyalty points & rewards" },
    { "name": "Subscription", "description": "Subscription plans" },
    { "name": "Nursery", "description": "Nursery directory" },
    { "name": "Seller", "description": "Seller dashboard & management" },
    { "name": "Admin", "description": "Admin management" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "password_confirmation"],
                "properties": {
                  "name": { "type": "string", "example": "Rina Kartika" },
                  "email": { "type": "string", "format": "email", "example": "rina@example.com" },
                  "phone": { "type": "string", "example": "081234567890" },
                  "password": { "type": "string", "minLength": 8, "example": "rahasia123" },
                  "password_confirmation": { "type": "string", "example": "rahasia123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registration successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logout successful" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send password reset link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "format": "email" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reset link sent" },
          "404": { "description": "Email not found" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "List all categories",
        "responses": {
          "200": { "description": "Category list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } }
        }
      }
    },
    "/categories/{category}": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get category by slug",
        "parameters": [{ "name": "category", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Category detail" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List products with filters",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "care", "in": "query", "schema": { "type": "string", "enum": ["mudah", "sedang", "sulit"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["harga-asc", "harga-desc", "terlaris", "rating"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 15 } }
        ],
        "responses": {
          "200": { "description": "Paginated product list" }
        }
      }
    },
    "/products/{product}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product detail by slug",
        "parameters": [{ "name": "product", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Product detail" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/products/{product}/favorite": {
      "post": {
        "tags": ["Products"],
        "summary": "Toggle product favorite",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "product", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Favorite toggled" }
        }
      }
    },
    "/stores": {
      "get": {
        "tags": ["Stores"],
        "summary": "List active stores",
        "responses": {
          "200": { "description": "Store list" }
        }
      }
    },
    "/stores/{store}": {
      "get": {
        "tags": ["Stores"],
        "summary": "Get store detail",
        "parameters": [{ "name": "store", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Store detail" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/stores/{store}/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List products by store",
        "parameters": [{ "name": "store", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Store products" }
        }
      }
    },
    "/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get cart contents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Cart with items, count, subtotal" }
        }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Clear entire cart",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Cart cleared" }
        }
      }
    },
    "/cart/items": {
      "post": {
        "tags": ["Cart"],
        "summary": "Add item to cart",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id", "quantity"],
                "properties": {
                  "product_id": { "type": "integer" },
                  "variant_id": { "type": "integer", "nullable": true },
                  "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Item added" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/cart/items/{cartItem}": {
      "put": {
        "tags": ["Cart"],
        "summary": "Update cart item quantity",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "cartItem", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantity"],
                "properties": { "quantity": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Item updated" },
          "403": { "description": "Not your cart item" }
        }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Remove item from cart",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "cartItem", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Item removed" },
          "403": { "description": "Not your cart item" }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List user orders",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Paginated order list" }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Create order from cart (checkout)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payment_method", "address"],
                "properties": {
                  "payment_method": { "type": "string", "enum": ["transfer", "ewallet", "qris", "cod"] },
                  "courier": { "type": "string", "default": "reguler" },
                  "note": { "type": "string", "nullable": true },
                  "address": {
                    "type": "object",
                    "required": ["label", "recipient", "phone", "street", "city", "province"],
                    "properties": {
                      "label": { "type": "string" },
                      "recipient": { "type": "string" },
                      "phone": { "type": "string" },
                      "street": { "type": "string" },
                      "city": { "type": "string" },
                      "province": { "type": "string" },
                      "postal_code": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/orders/{order}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get order detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "order", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Order detail with items, payment, shipment" },
          "403": { "description": "Not your order" }
        }
      }
    },
    "/orders/{order}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancel order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "order", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Order cancelled, stock released" },
          "422": { "description": "Cannot cancel at this status" }
        }
      }
    },
    "/orders/{order}/pay": {
      "post": {
        "tags": ["Payments"],
        "summary": "Create payment for order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "order", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["method"],
                "properties": { "method": { "type": "string", "enum": ["transfer", "ewallet", "qris", "cod"] } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment instructions" }
        }
      }
    },
    "/orders/{order}/shipment": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get order shipment tracking",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "order", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Shipment tracking info" }
        }
      }
    },
    "/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "List reviews",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "product_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Paginated review list" }
        }
      },
      "post": {
        "tags": ["Reviews"],
        "summary": "Submit review (only for completed orders)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_item_id", "rating"],
                "properties": {
                  "order_item_id": { "type": "integer" },
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "comment": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Review submitted" },
          "403": { "description": "Order not completed or not yours" }
        }
      }
    },
    "/my-garden": {
      "get": {
        "tags": ["My Garden"],
        "summary": "List user plants",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User plant list" }
        }
      },
      "post": {
        "tags": ["My Garden"],
        "summary": "Add plant to garden",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nickname", "plant_species_id"],
                "properties": {
                  "nickname": { "type": "string" },
                  "plant_species_id": { "type": "integer" },
                  "location": { "type": "string" },
                  "planted_at": { "type": "string", "format": "date" },
                  "water_frequency_days": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Plant added" }
        }
      }
    },
    "/my-garden/reminders": {
      "get": {
        "tags": ["My Garden"],
        "summary": "List all reminders across all plants",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "All reminders" }
        }
      }
    },
    "/my-garden/{userPlant}": {
      "get": {
        "tags": ["My Garden"],
        "summary": "Get plant detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Plant detail with photos, growth logs, care logs" },
          "403": { "description": "Not your plant" }
        }
      },
      "put": {
        "tags": ["My Garden"],
        "summary": "Update plant info",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Plant updated" }
        }
      },
      "delete": {
        "tags": ["My Garden"],
        "summary": "Remove plant from garden",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Plant removed" }
        }
      }
    },
    "/my-garden/{userPlant}/growth": {
      "get": {
        "tags": ["My Garden"],
        "summary": "List growth logs for a plant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Growth log list" } }
      },
      "post": {
        "tags": ["My Garden"],
        "summary": "Log plant growth",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "height_cm": { "type": "number" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Growth logged" } }
      }
    },
    "/my-garden/{userPlant}/care": {
      "post": {
        "tags": ["My Garden"],
        "summary": "Log plant care activity",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "enum": ["siram", "pupuk", "repot", "cek-hama", "pangkas"] },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Care logged" } }
      }
    },
    "/my-garden/{userPlant}/reminders": {
      "get": {
        "tags": ["My Garden"],
        "summary": "List reminders for a plant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Reminder list" } }
      },
      "post": {
        "tags": ["My Garden"],
        "summary": "Create reminder for a plant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "userPlant", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "frequency_days"],
                "properties": {
                  "type": { "type": "string", "enum": ["siram", "pupuk", "repot", "cek-hama", "pangkas"] },
                  "frequency_days": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Reminder created" } }
      }
    },
    "/my-garden/reminders/{plantReminder}/done": {
      "post": {
        "tags": ["My Garden"],
        "summary": "Mark reminder as done",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "plantReminder", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Reminder marked done, rescheduled" } }
      }
    },
    "/plant-species": {
      "get": {
        "tags": ["Plant Species"],
        "summary": "List plant species",
        "responses": { "200": { "description": "Species list" } }
      }
    },
    "/plant-species/{plantSpecies}": {
      "get": {
        "tags": ["Plant Species"],
        "summary": "Get species detail",
        "parameters": [{ "name": "plantSpecies", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Species detail" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/plant-finder/questions": {
      "get": {
        "tags": ["Plant Finder"],
        "summary": "Get plant finder questions",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Questions and options" } }
      }
    },
    "/plant-finder/recommend": {
      "post": {
        "tags": ["Plant Finder"],
        "summary": "Get plant recommendations",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lokasi": { "type": "string" },
                  "pengalaman": { "type": "string" },
                  "tujuan": { "type": "string" },
                  "waktu": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Top 3 recommended species" } }
      }
    },
    "/plant-diagnosis": {
      "post": {
        "tags": ["Plant Diagnosis"],
        "summary": "Diagnose plant health",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_plant_id", "symptoms"],
                "properties": {
                  "user_plant_id": { "type": "integer" },
                  "symptoms": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Diagnosis result with advice" } }
      }
    },
    "/community/posts": {
      "get": {
        "tags": ["Community"],
        "summary": "List community posts",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Paginated posts" } }
      },
      "post": {
        "tags": ["Community"],
        "summary": "Create a post",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": { "content": { "type": "string", "maxLength": 5000 } }
              }
            }
          }
        },
        "responses": { "201": { "description": "Post created" } }
      }
    },
    "/community/posts/{post}": {
      "get": {
        "tags": ["Community"],
        "summary": "Get post detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "post", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Post with comments" } }
      },
      "delete": {
        "tags": ["Community"],
        "summary": "Delete own post",
        "security": [{ "bearerAuth": [] }],
